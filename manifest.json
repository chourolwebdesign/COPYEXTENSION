{
  "manifest_version": 3,
  "name": "CopyPaste Unlocker",
  "version": "3.0.0",
  "description": "Restores Ctrl+C, Ctrl+V and Ctrl+X on azubiheft.de by silencing the page scripts that block clipboard events.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CopyPaste Unlocker",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://azubiheft.de/*",
        "https://www.azubiheft.de/*"
      ],
      "js": [
        "src/unlock.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://azubiheft.de/*",
        "https://www.azubiheft.de/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://azubiheft.de/*",
        "https://www.azubiheft.de/*"
      ],
      "js": [
        "src/intro.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
